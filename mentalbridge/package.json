{
  "name": "mentalbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "format": "prettier --config prettier.config.mjs --write \"app/providers.tsx\" \"app/api/**/*.ts\" \"lib/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"proxy.ts\" \"*.config.{ts,mts,mjs}\" \"package.json\" \"../.github/workflows/*.yml\"",
    "format:check": "prettier --config prettier.config.mjs --check \"app/providers.tsx\" \"app/api/**/*.ts\" \"lib/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"proxy.ts\" \"*.config.{ts,mts,mjs}\" \"package.json\" \"../.github/workflows/*.yml\"",
    "contracts:sync": "node scripts/identity-contract.mjs --sync",
    "contracts:generate": "node scripts/identity-contract.mjs",
    "contracts:check": "node scripts/identity-contract.mjs --check",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run contracts:check && npm run test:unit && npm run build",
    "ci": "npm run quality && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "framer-motion": "^13.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
