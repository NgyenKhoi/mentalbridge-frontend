# Server-only upstream URL. Never expose it with a NEXT_PUBLIC_ prefix.
IDENTITY_API_BASE_URL=http://localhost:8080

# Server-only total Identity request timeout in milliseconds (100-30000).
IDENTITY_API_TIMEOUT_MS=2000

# Server-only Care URL. The browser calls the Next.js BFF and never this URL.
CARE_API_BASE_URL=http://localhost:8081

# Server-only total Care request timeout in milliseconds (100-30000).
CARE_API_TIMEOUT_MS=3000

# Only a reviewed, published questionnaire is usable. vi-VN intentionally
# returns unavailable until the Care service publishes approved wording.
CARE_QUESTIONNAIRE_LOCALE=vi-VN
