{
  "name": "mentalbridge-mobile",
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.104.1",
    "axios": "1.20.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:android:smoke": "bash scripts/verify-native-android.sh",
    "e2e:android:assessment": "bash scripts/verify-android-assessment-e2e.sh",
    "e2e:android:support-plan": "bash scripts/verify-android-support-plan-e2e.sh",
    "e2e:android:emotion": "bash scripts/verify-android-emotion-e2e.sh",
    "native:ios:smoke": "bash scripts/verify-native-ios.sh",
    "build:bundle": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && npm run build:bundle"
  },
  "private": true,
  "engines": {
    "node": "22.13.0",
    "npm": "10.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
