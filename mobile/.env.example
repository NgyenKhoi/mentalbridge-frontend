# Exactly one public mobile edge URL is selected per dev/staging/prod build.
# Never place credentials, API keys, or private/per-service URLs here.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Request timeout in milliseconds, from 100 through 30000.
EXPO_PUBLIC_API_TIMEOUT_MS=5000

# Optional public URL of the original Next.js landing page.
# The development app uses Next.js on 127.0.0.1:3000 through its Metro server.
# Outside development this URL must use HTTPS.
# EXPO_PUBLIC_LANDING_URL=https://staging.mentalbridge.online/
