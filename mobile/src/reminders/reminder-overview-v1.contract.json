{
  "source": "contracts/openapi/content-notification-service.yaml#/components/schemas/ReminderOverview",
  "apiVersion": "1.10.0",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "asOf",
      "localDate",
      "timeZone",
      "preferences",
      "today",
      "previews",
      "unavailableCategories"
    ],
    "properties": {
      "schemaVersion": {
        "type": "string",
        "const": "1.0"
      },
      "asOf": {
        "type": "string",
        "format": "date-time"
      },
      "localDate": {
        "type": "string",
        "format": "date"
      },
      "timeZone": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "preferences": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notificationsEnabled",
          "channels",
          "contentGroups",
          "quietHours",
          "email",
          "version",
          "updatedAt"
        ],
        "properties": {
          "notificationsEnabled": {
            "type": "boolean"
          },
          "channels": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inApp", "email", "push"],
            "properties": {
              "inApp": {
                "type": "boolean"
              },
              "email": {
                "type": "boolean"
              },
              "push": {
                "type": "boolean",
                "description": "Persisted preference only; push delivery remains deferred until mobile device registration."
              }
            }
          },
          "contentGroups": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "journalReminder",
              "emotionCheckIn",
              "streakMilestone",
              "screeningReassessment",
              "appointmentMessage",
              "resourceSystem",
              "communityInteraction"
            ],
            "properties": {
              "journalReminder": {
                "type": "boolean"
              },
              "emotionCheckIn": {
                "type": "boolean"
              },
              "streakMilestone": {
                "type": "boolean"
              },
              "screeningReassessment": {
                "type": "boolean"
              },
              "appointmentMessage": {
                "type": "boolean"
              },
              "resourceSystem": {
                "type": "boolean"
              },
              "communityInteraction": {
                "type": "boolean"
              }
            }
          },
          "quietHours": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "start", "end", "timeZone"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "start": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "timeZone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "IANA time zone used to evaluate the local-day quiet window, including windows crossing midnight."
              }
            }
          },
          "email": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cadence",
              "wellbeingDigestEnabled",
              "resourceRemindersEnabled",
              "dailyDigestTime",
              "resourceReminderTime"
            ],
            "properties": {
              "cadence": {
                "type": "string",
                "enum": ["IMMEDIATE", "DAILY_DIGEST", "WEEKLY_DIGEST"]
              },
              "wellbeingDigestEnabled": {
                "type": "boolean"
              },
              "resourceRemindersEnabled": {
                "type": "boolean"
              },
              "dailyDigestTime": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "resourceReminderTime": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "appointmentRemindersEnabled": {
                "type": "boolean"
              }
            }
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "today": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "category", "status", "action"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "category": {
              "type": "string",
              "enum": ["JOURNAL", "EMOTION_CHECK_IN"]
            },
            "status": {
              "type": "string",
              "enum": ["DUE", "COMPLETED"]
            },
            "action": {
              "type": "string",
              "enum": ["OPEN_JOURNAL", "OPEN_EMOTION_CHECK_IN"]
            }
          }
        }
      },
      "previews": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "channel",
            "state",
            "nextEligibleAt",
            "estimate",
            "latestDelivery"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "JOURNAL_REMINDER",
                "EMOTION_CHECKIN_REMINDER",
                "DAILY_DIGEST",
                "RESOURCE_REMINDER",
                "APPOINTMENT_EMAIL"
              ]
            },
            "channel": {
              "type": "string",
              "enum": ["IN_APP", "EMAIL"]
            },
            "state": {
              "type": "string",
              "enum": [
                "ELIGIBLE",
                "SCHEDULED",
                "QUIET_HOURS",
                "PAUSED",
                "DISABLED",
                "COMPLETED",
                "NOT_NEEDED",
                "ALREADY_DELIVERED",
                "IN_PROGRESS",
                "UNAVAILABLE"
              ]
            },
            "nextEligibleAt": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "estimate": {
              "type": "boolean",
              "const": true
            },
            "latestDelivery": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state", "recordedAt"],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "PROCESSING",
                        "CLAIMED",
                        "DELIVERED",
                        "FAILED",
                        "CANCELLED",
                        "INVALIDATED",
                        "SUPPRESSED",
                        "EXPIRED",
                        "UNKNOWN"
                      ]
                    },
                    "recordedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "unavailableCategories": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 4,
        "items": {
          "type": "string",
          "enum": ["SUPPORT_PLAN", "RESOURCES", "ASSESSMENT", "PUSH"]
        }
      }
    }
  }
}
